{
  "name": "MemberProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "matricula": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "estudante",
        "professor",
        "funcionario",
        "administrador"
      ],
      "default": "estudante"
    },
    "class_or_department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "ativo",
        "bloqueado"
      ],
      "default": "pendente"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}